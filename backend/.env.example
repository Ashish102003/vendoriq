APP_NAME=VendorIQ
ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@localhost:3306/vendoriq
SECRET_KEY=your-secret-key-here

# Authentication
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial admin (used by python -m app.scripts.create_initial_admin)
INITIAL_ADMIN_EMAIL=admin@vendoriq.com
INITIAL_ADMIN_PASSWORD=change-me-please
INITIAL_ADMIN_FIRST_NAME=Admin
INITIAL_ADMIN_LAST_NAME=User